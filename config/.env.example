# Parameter yang dikirim
KLHK_FIELDS="datetime,pH,cod,tss,nh3n,flow"
# Maks percobaan kirim ulang data duplikat   
KLHK_MAX_DUP_RETRY="3"
# Target menit kirim ulang                        
KLHK_TARGET_MINUTE="10"                        



